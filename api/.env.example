# Server
PORT=4000
NODE_ENV=development
LOG_LEVEL=info

# Database
DATABASE_URL=postgresql://user:password@host/db?sslmode=require
DIRECT_URL=postgresql://user:password@host/db?sslmode=require

# BNB Testnet
CHAIN_ID=97
NETWORK_NAME=BNB Smart Chain Testnet
NATIVE_CURRENCY_NAME=BNB
NATIVE_CURRENCY_SYMBOL=tBNB
EXPLORER_NAME=BscScan
RPC_URL=https://data-seed-prebsc-1-s1.bnbchain.org:8545
EXPLORER_URL=https://testnet.bscscan.com

# Contract addresses (dari deployments.json)
VAULT_ADDRESS=
AUCTION_ADDRESS=
LOAN_MANAGER_ADDRESS=
MOCK_USDC_ADDRESS=
DEPLOY_BLOCK=

# Admin signer
ADMIN_PRIVATE_KEY=
ADMIN_API_KEY=dev-admin-key-change-me

# CORS
CORS_ORIGIN=https://homr.web.id,https://www.homr.web.id,http://localhost:3000,http://localhost:5173

# Native NEAR proof registry (separate from the EVM baseline)
NEAR_NETWORK_ID=testnet
NEAR_RPC_URL=https://archival-rpc.testnet.near.org
NEAR_CONTRACT_ID=
